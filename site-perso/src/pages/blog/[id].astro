---
import Base from '../../layouts/Base.astro';
import CtaButton from '../../components/CtaButton.astro';
import { getPosts, formatDate } from '../../lib';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} | Anthony Goulet`} description={post.data.description}>
  <article>
    <header class="article-hero">
      <div class="container narrow">
        <a href="/blog" class="article-meta" style="text-decoration:none;">← Tous les articles</a>
        <h1 style="margin-top: 18px;">{post.data.title}</h1>
        <p class="article-meta">{formatDate(post.data.date)} · Anthony Goulet</p>
      </div>
    </header>
    <div class="prose"><Content /></div>
    <div class="container">
      <div class="article-cta">
        <h3>Tu veux voir ce que ça donne pour ta situation?</h3>
        <p>On en jase 1 à 1, gratuitement et sans engagement.</p>
        <CtaButton note={false} />
      </div>
    </div>
    <p class="article-disclaimer">
      Cet article est fourni à titre informatif seulement et ne constitue pas un conseil financier, fiscal ou juridique
      personnalisé. Les règles et les montants peuvent changer : vérifie toujours ta situation avec un professionnel.
    </p>
  </article>
</Base>
