---
import Base from '../layouts/Base.astro';
import CtaButton from '../components/CtaButton.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib';
import {
  hero, about, services, check, steps, testimonials, partners, quiz, faq, booking, contact, legal, cta, ghl,
} from '../config';

const latestPosts = (await getPosts()).slice(0, 3);
const isVideoFile = about.videoUrl.endsWith('.mp4');
---
<Base>
  <!-- HERO : grande phrase centrée + 3 chemins -->
  <section class="hero">
    {hero.photo ? <div class="hero__bg"><img src={hero.photo} alt="" /></div> : <div class="hero__lines" aria-hidden="true"></div>}
    <div class="container hero__inner">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1><span class="dash">–</span> {hero.title} <span class="dash">–</span></h1>
      <p class="hero__sub">Choisis ce qui te ressemble. On en jase lors d'un appel découverte gratuit.</p>
      <div class="paths">
        {hero.paths.map((p) => (
          <a href="#reserver" class="btn" data-need={p.need}>{p.label}</a>
        ))}
      </div>
      <p class="hero__cta">Ou <a href="#reserver">réserve directement ton appel →</a></p>
    </div>
  </section>

  <!-- À PROPOS (foncé) : texte + photo avec badge -->
  <section class="section section--dark" id="a-propos">
    <div class="container about">
      <div>
        <h2>{about.title}</h2>
        {about.paragraphs.map((p) => <p>{p}</p>)}
        <div class="about__stats">
          {about.stats.map((s) => (
            <div>
              <div class="about__stat-value">{s.value}</div>
              <div class="about__stat-label">{s.label}</div>
            </div>
          ))}
        </div>
        <CtaButton note={false} />
      </div>
      <div class:list={['portrait', !about.photo && !about.videoUrl && 'portrait--empty']}>
        {about.videoUrl ? (
          isVideoFile ? (
            <video src={about.videoUrl} controls playsinline poster={about.photo || undefined} />
          ) : (
            <iframe src={about.videoUrl} title="Vidéo de présentation" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy" />
          )
        ) : about.photo ? (
          <img src={about.photo} alt="Anthony Goulet" loading="lazy" />
        ) : (
          <div class="placeholder"><div><span>AG</span>Photo ou vidéo à venir</div></div>
        )}
        <div class="portrait__badge">
          <strong>Anthony Goulet</strong>
          <span>{legal.title}<br />AMF no {legal.amfNumber}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES : tuiles -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head">
        <h2>{services.title}</h2>
        <a href="#reserver" class="more-link">Réserver un appel <span aria-hidden="true">›</span></a>
      </div>
      <div class="tiles">
        {services.items.map((s, i) => (
          <article class="tile">
            <span class="tile__tag">{s.tag}</span>
            <span class="tile__num" aria-hidden="true">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- QUESTION + BOUTON : texte à gauche, image à droite -->
  <section class="split">
    <div class="split__text">
      <h2>{check.title}</h2>
      <p>{check.text}</p>
      <div><a href="#reserver" class="btn" data-need="Faire le point sur ma situation">{check.button}</a></div>
    </div>
    <div class="split__media">
      {check.image ? (
        <img src={check.image} alt="" loading="lazy" />
      ) : (
        <>
          <div class="split__pattern"></div>
          <div class="split__shield"><Icon name="shield" size={120} /></div>
        </>
      )}
    </div>
  </section>

  <!-- ÉTAPES -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <h2>{steps.title}</h2>
        <a href="#reserver" class="more-link">Commencer <span aria-hidden="true">›</span></a>
      </div>
      <div class="steps">
        {steps.items.map((s, i) => (
          <div class="step">
            <div class="step__num">0{i + 1}</div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RÉSEAU (foncé) -->
  <section class="section section--dark" id="reseau">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Partenaires</span>
          <h2>{partners.title}</h2>
        </div>
        <p class="muted" style="max-width:440px;margin:0;">{partners.intro}</p>
      </div>
      <div class="featured-partner">
        <div>
          <span class="featured-partner__tag">Partenaire principal · Cartes de crédit</span>
          <h3>{partners.featured.name}</h3>
          <p>{partners.featured.text}</p>
        </div>
        {partners.featured.url && (
          <a href={partners.featured.url} class="btn btn--sm" target="_blank" rel="noopener sponsored">Découvrir</a>
        )}
      </div>
      <div class="chips">
        {partners.resources.map((r) => <span class="chip">{r}</span>)}
      </div>
      <p style="margin-top: 28px;">Besoin d'une référence? <a href="#reserver" style="color:var(--gold);font-weight:700;">Parle-m'en lors de ton appel découverte ›</a></p>
      <p class="disclosure">{partners.disclosure}</p>
    </div>
  </section>

  <!-- BLOG -->
  {latestPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Derniers articles</h2>
          <a href="/blog" class="more-link">Tous les articles <span aria-hidden="true">›</span></a>
        </div>
        <div class="posts">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <!-- QUIZ BONUS -->
  {quiz.enabled && quiz.url && (
    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div class="quiz-band">
          <div>
            <h3>{quiz.title}</h3>
            <p>{quiz.text}</p>
          </div>
          <a href={quiz.url} class="btn">{quiz.button}</a>
        </div>
      </div>
    </section>
  )}

  <!-- TÉMOIGNAGES (caché si la liste est vide) -->
  {testimonials.length > 0 && (
    <section class="section section--tint">
      <div class="container">
        <div class="quotes" id="quotes">
          {testimonials.map((t, i) => (
            <blockquote class:list={['quote', i === 0 && 'is-active']}>
              <p>{t.quote}</p>
              <cite>— {t.name}</cite>
            </blockquote>
          ))}
          {testimonials.length > 1 && (
            <div class="quotes__nav">
              <button type="button" data-dir="-1" aria-label="Témoignage précédent">‹</button>
              <button type="button" data-dir="1" aria-label="Témoignage suivant">›</button>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section section--tint" id="faq">
    <div class="container narrow">
      <h2 class="center">{faq.title}</h2>
      <div class="faq" style="margin-top: 40px;">
        {faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RÉSERVATION (foncé) : calendrier GoHighLevel + formulaire « m'écrire » -->
  <section class="section section--dark" id="reserver">
    <div class="container booking">
      <div>
        <span class="eyebrow">Prochaine étape</span>
        <h2>{booking.title}</h2>
        <p class="muted">{booking.text}</p>
        <ul class="perks">{booking.perks.map((p) => <li>{p}</li>)}</ul>
        <ul class="contact-list">
          <li><a href={contact.phoneHref}><Icon name="phone" />{contact.phone}</a></li>
          <li><a href={`mailto:${contact.email}`}><Icon name="mail" />{contact.email}</a></li>
          {contact.instagram && <li><a href={contact.instagram} target="_blank" rel="noopener"><Icon name="instagram" />Instagram</a></li>}
        </ul>

        <details class="write-me" id="write-me">
          <summary>Tu préfères m'écrire? ›</summary>
          <form class="form" name="contact" method="POST" action="/merci" data-netlify="true" netlify-honeypot="bot-field" id="book-form" data-ghl={ghl.sendLeads ? 'on' : 'off'}>
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden"><label>Ne pas remplir <input name="bot-field" /></label></p>
            <div class="row">
              <label>Prénom* <input id="bf-prenom" name="prenom" required autocomplete="given-name" /></label>
              <label>Nom* <input id="bf-nom" name="nom" required autocomplete="family-name" /></label>
            </div>
            <div class="row">
              <label>Courriel* <input id="bf-courriel" type="email" name="courriel" required autocomplete="email" /></label>
              <label>Téléphone <input id="bf-tel" type="tel" name="telephone" autocomplete="tel" /></label>
            </div>
            <label>Ce qui t'amène
              <select id="bf-besoin" name="besoin">
                <option value="">Choisis une option</option>
                {booking.needs.map((n) => <option>{n}</option>)}
              </select>
            </label>
            <label>Ton message* <textarea id="bf-message" name="message" required></textarea></label>
            <p class="fine">
              En envoyant, tu acceptes qu'Anthony Goulet utilise ces renseignements pour te recontacter.
              <a href="/mentions-legales#confidentialite">Politique de confidentialité</a>
            </p>
            <button type="submit" class="btn btn--block">Envoyer</button>
          </form>
          <p class="sent hidden" id="sent">Merci! Ton message est envoyé. Je te reviens rapidement.</p>
        </details>
      </div>

      <div class="booking-card calendar-card">
        {ghl.calendarId ? (
          <iframe
            src={`https://api.leadconnectorhq.com/widget/booking/${ghl.calendarId}`}
            id={`${ghl.calendarId}_booking`}
            title="Réserver un appel découverte"
            scrolling="no"
            loading="lazy"
          ></iframe>
        ) : (
          <div class="calendly-missing">
            <h3>Calendrier bientôt disponible</h3>
            <p>En attendant, appelle-moi ou écris-moi directement.</p>
            <a href={contact.phoneHref} class="btn">Appeler {contact.phone}</a>
          </div>
        )}
      </div>
    </div>
  </section>
</Base>

{ghl.calendarId && <script is:inline src="https://link.msgsgo.com/js/form_embed.js" async></script>}
<script>
  const form = document.getElementById('book-form') as HTMLFormElement | null;
  const select = document.getElementById('bf-besoin') as HTMLSelectElement | null;

  // Les boutons « chemins » choisissent le besoin d'avance (utile si la personne choisit de m'écrire)
  document.querySelectorAll<HTMLElement>('[data-need]').forEach((el) =>
    el.addEventListener('click', () => {
      if (select) select.value = el.dataset.need ?? '';
    }),
  );

  // Formulaire « m'écrire » : copie Netlify Forms + contact créé dans GoHighLevel
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(data as any).toString(),
    }).catch(() => {});
    if (form.dataset.ghl === 'on') {
      fetch('/.netlify/functions/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...Object.fromEntries(data), page: location.href }),
        keepalive: true,
      }).catch(() => {});
    }
    form.classList.add('hidden');
    document.getElementById('sent')?.classList.remove('hidden');
  });

  // Témoignages : défilement
  const quotes = Array.from(document.querySelectorAll('#quotes .quote'));
  let current = 0;
  document.querySelectorAll<HTMLButtonElement>('#quotes [data-dir]').forEach((b) =>
    b.addEventListener('click', () => {
      quotes[current].classList.remove('is-active');
      current = (current + Number(b.dataset.dir) + quotes.length) % quotes.length;
      quotes[current].classList.add('is-active');
    }),
  );
</script>
