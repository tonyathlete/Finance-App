---
import { cta } from '../config';

interface Props {
  note?: boolean;
  size?: 'sm';
}
const { note = true, size } = Astro.props;
---
<div class="cta-block">
  <a href="/#reserver" class:list={['btn', 'btn--gold', size === 'sm' && 'btn--sm']}>
    {cta.label}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </a>
  {note && <span class="cta-note">{cta.note}</span>}
</div>
