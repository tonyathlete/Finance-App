---
import { cta } from '../config';
---
<div class="sticky-cta" id="sticky-cta">
  <a href="/#reserver" class="btn btn--gold">{cta.label}</a>
</div>
<script>
  // Visible après le hero, cachée quand la section rendez-vous est à l'écran
  const bar = document.getElementById('sticky-cta');
  const targets = ['reserver', 'rendez-vous'].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const seen = new Set<Element>();
  let bookingVisible = false;
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
      bookingVisible = seen.size > 0;
      update();
    });
    targets.forEach((t) => io.observe(t));
  }
  function update() {
    bar?.classList.toggle('is-visible', window.scrollY > 500 && !bookingVisible);
  }
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
